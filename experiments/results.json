        "where": "experiments/reports/rare_f1_ceiling/report.json"
      },
      "partition_frontier": {
        "what": "rare-domain F1 and ARI across Leiden resolutions",
        "where": "experiments/reports/rare_domain_baseline_frontier/report.json"
      },
      "prototype_sweep": {
        "what": "rare-F1 after the refresh-interval sweep: 0.0558 / 0.0069 / 0.0182",
        "where": "experiments/runs/stage2_C_t0.2_dq0.2_seed*_initA0_pr0.8_T30/metrics.json"
      },
      "marker_screen": {
        "what": "per-domain Wilcoxon statistics. Two domains clear all three criteria (follicle, hilum); only follicle's marker is spatially specific, since hilum's COL1A2 is high across the whole capsule and does not localize the domain",
        "where": "experiments/reports/marker_screen/report.json"
      },
      "batching_retention": {
        "what": "in-batch spatial-edge retention: 0.78% -> 69.4% -> 100%",
        "where": "experiments/runs/stage1a_batching_probe/report.json"
      }
    }
  },
